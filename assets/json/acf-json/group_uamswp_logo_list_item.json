{
    "key": "group_logo_list_items",
    "title": "Logo List Items",
    "fields": [
        {
            "key": "field_logo_title",
            "label": "Name of Organization",
            "name": "logo_title",
            "type": "text",
            "instructions": "Use the full name of the organization. Avoid using acronyms unless that is the official name of the organization.",
            "required": 1,
            "conditional_logic": 0,
            "wrapper": {
                "width": "",
                "class": "",
                "id": ""
            },
            "default_value": "",
            "placeholder": "",
            "prepend": "",
            "append": "",
            "maxlength": ""
        },
        {
            "key": "field_logo_image",
            "label": "Logo of Organization",
            "name": "logo_image",
            "type": "image",
            "instructions": "Minimum dimensions: 884x538.<br />The image must be a PNG with a transparent background. Do not simply save a JPEG as a PNG. Crop the image to the bounds of the logo content before uploading the image.",
            "required": 0,
            "conditional_logic": 0,
            "wrapper": {
                "width": "",
                "class": "",
                "id": ""
            },
            "uploader": "",
            "acfe_thumbnail": 0,
            "return_format": "id",
            "preview_size": "medium",
            "min_width": 884,
            "min_height": 538,
            "min_size": "",
            "max_width": "",
            "max_height": "",
            "max_size": "",
            "mime_types": "png",
            "ratio_width": 0,
            "ratio_height": 0,
            "ratio_margin": 0,
            "library": "all"
        },
        {
            "key": "field_logo_link",
            "label": "URL for Organization",
            "name": "logo_link",
            "type": "url",
            "instructions": "Include the URL for either the organization's website or a UAMS landing page related to that organization.",
            "required": 0,
            "conditional_logic": 0,
            "wrapper": {
                "width": "",
                "class": "",
                "id": ""
            },
            "default_value": "",
            "placeholder": ""
        },
        {
            "key": "field_logo_link_text",
            "label": "Link Text",
            "name": "logo_link_text",
            "type": "text",
            "instructions": "The default text for the link is \"Visit Their Website.\" Enter new text if the URL goes somewhere other than their website. For example, if the link went to a landing page about our partnership with this organization, you could say \"Learn about our partnership\".",
            "required": 0,
            "conditional_logic": [
                [
                    {
                        "field": "field_logo_link",
                        "operator": "!=empty"
                    }
                ]
            ],
            "wrapper": {
                "width": "",
                "class": "",
                "id": ""
            },
            "default_value": "",
            "placeholder": "Visit Their Website",
            "prepend": "",
            "append": "",
            "maxlength": ""
        },
        {
            "key": "field_logo_link_target",
            "label": "Link Target",
            "name": "logo_link_target",
            "type": "radio",
            "instructions": "The block on the page can define whether the links for all items within that block open in the same window or in a new window. Or you can override that behavior to always do one or the other for this specific item's link.",
            "required": 1,
            "conditional_logic": [
                [
                    {
                        "field": "field_logo_link",
                        "operator": "!=empty"
                    }
                ]
            ],
            "wrapper": {
                "width": "",
                "class": "",
                "id": ""
            },
            "choices": {
                "inherit": "No Override",
                "_blank": "Always Open in New Window",
                "_self": "Always Open in Same Window"
            },
            "allow_null": 0,
            "other_choice": 0,
            "default_value": "",
            "layout": "vertical",
            "return_format": "value",
            "save_other_choice": 0
        },
        {
            "key": "field_logo_category",
            "label": "Categories",
            "name": "logo_category",
            "type": "taxonomy",
            "instructions": "Categories will be used to filter which items are displayed in a block. Multiple categories can be used to either expand or narrow the selection for what is displayed in a block.",
            "required": 0,
            "conditional_logic": 0,
            "wrapper": {
                "width": "",
                "class": "",
                "id": ""
            },
            "taxonomy": "logo-list-category",
            "field_type": "multi_select",
            "allow_null": 0,
            "add_term": 1,
            "save_terms": 1,
            "load_terms": 1,
            "return_format": "id",
            "acfe_bidirectional": {
                "acfe_bidirectional_enabled": "0"
            },
            "multiple": 0
        },
        {
            "key": "field_logo_label",
            "label": "Label for Organization",
            "name": "logo_label",
            "type": "taxonomy",
            "instructions": "The label can be used to distinguish between organizations within a category. Examples: industry, city, state.",
            "required": 0,
            "conditional_logic": 0,
            "wrapper": {
                "width": "",
                "class": "",
                "id": ""
            },
            "taxonomy": "logo-list-label",
            "field_type": "select",
            "allow_null": 0,
            "add_term": 1,
            "save_terms": 1,
            "load_terms": 1,
            "return_format": "id",
            "acfe_bidirectional": {
                "acfe_bidirectional_enabled": "0"
            },
            "multiple": 0
        },
        {
            "key": "field_logo_shortdescr",
            "label": "Short Description",
