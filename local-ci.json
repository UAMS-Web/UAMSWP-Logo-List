{
  "base": "main",
  "php": "8.4",
  "chain": false,
  "guard": {
    "deny": [
      "sentinel-key\\.php$",
      "wp-config\\.php$",
      "\\.sql(\\.gz)?$",
      "\\.(csv|tsv|xlsx?)$",
      "\\.env(\\.|$)",
      "\\.pem$",
      "\\.key$"
    ]
  },
  "jobs": [
    {
      "name": "lint",
      "run": "php -l",
      "each": [
        "**/*.php",
        "!vendor/**",
        "!tests/Integration/vendor/**",
        "!tests-legacy/**"
      ],
      "always": true
    },
    {
      "name": "lint-floor",
      "run": "php -l",
      "php": "8.2",
      "each": [
        "**/*.php",
        "!vendor/**",
        "!tests/**"
      ],
      "always": true
    },
    {
      "name": "synced-files",
      "run": "node .claude/skills/synced-files/scripts/check-synced-files.mjs",
      "always": true,
      "requires": [
        "bin:node"
      ]
    },
    {
      "name": "no-emoji",
      "run": "node .claude/skills/writing-comments/scripts/check-no-emoji.mjs",
      "always": true,
      "requires": [
        "bin:node"
      ]
    },
    {
      "name": "aggregate-needs",
      "run": "node .claude/skills/code-quality/scripts/check-aggregate-needs.mjs",
      "always": true,
      "requires": [
        "bin:node"
      ]
    },
    {
      "name": "pint",
      "run": "composer test:pint",
      "paths": [
        "**/*.php",
        "!vendor/**",
        "pint.json",
        "composer.lock"
      ]
    },
    {
      "name": "rector",
      "run": "composer test:refactor",
      "paths": [
        "**/*.php",
        "!vendor/**",
        "rector.php",
        "composer.lock"
      ]
    },
    {
      "name": "phpstan",
      "run": "composer stan",
      "paths": [
        "**/*.php",
        "!vendor/**",
        "phpstan.neon*",
        "composer.lock"
      ]
    },
    {
      "name": "pest-unit",
      "run": "composer test:unit",
      "paths": [
        "**/*.php",
        "!vendor/**",
        "!tests/Integration/**",
        "phpunit.xml*",
        "composer.lock",
        "tests/**"
      ]
    },
    {
      "name": "build-tests",
      "run": "npm run test:build",
      "paths": [
        "assets/**",
        "gulpfile.js",
        "package.json",
        "package-lock.json",
        "tests/build/**"
      ],
      "requires": [
        "bin:node"
      ]
    }
  ]
}
