# Auto detect text files and perform LF normalization
* text=auto eol=lf

# Unified diff context uses a single space for an unchanged blank line.
/patches/*.patch whitespace=-blank-at-eol,-blank-at-eof

# The GitHub download keeps only what the plugin runs: every top-level entry
# is left out, then each runtime path is put back. A new runtime folder needs
# its own line here, in the same change. See the keep-the-download-to-what-runs
# rule and the download-archive-check skill.
/* export-ignore
/.* export-ignore
/uamswp-logo-list.php -export-ignore
/required-plugins.php -export-ignore
/includes -export-ignore
/templates -export-ignore
/tgm -export-ignore
/assets -export-ignore
# The stylesheet source is built into assets/css/app.css and is not run.
/assets/scss export-ignore
